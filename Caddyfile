{
  order replace after reverse_proxy
  order replace before encode
}

:8096 {
  @injected path /inject/*
  @uncached path /web/ /web/index.html /inject/*

  # The entrypoint and injected scripts must reflect each deployed image.
  # Remove validators on both requests and responses so an old browser cache
  # cannot keep serving a stale entrypoint or injection.
  request_header @uncached -If-None-Match
  request_header @uncached -If-Modified-Since

  header @uncached {
    defer
    Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Pragma "no-cache"
    Expires "0"
    -ETag
    -Last-Modified
  }

  handle @injected {
    root * /srv
    header {
      Content-Type application/javascript
    }
    file_server
  }

  reverse_proxy jellyfin:8096 {
    header_up Accept-Encoding identity
  }

  # Match Jellyfin web entrypoints
  @jellyweb path /web/ /web/index.html
  replace @jellyweb {
    re "(?i)</body>" `
<!-- script defer src="/inject/frontend-search-filters.js"></script -->
<script defer src="/inject/log-viewer-inject.js"></script>
<script defer src="/inject/native-right-click-title.js"></script>
<script defer src="/inject/playlist-menu.js"></script>
<script defer src="/inject/player-navigation.js"></script>
<script defer src="/inject/touch-thumbnail-play.js"></script>
<script defer src="/inject/previews-badges.js"></script>
<script defer src="/inject/orientation-filter.js"></script>
<script defer src="/inject/video-card-titles.js"></script>
<script defer src="/inject/search-flex-wrap.js"></script>
<script defer src="/inject/search-input-maxlength.js"></script>
<script defer src="/inject/search-limit.js"></script>
</body>`
  }
}
